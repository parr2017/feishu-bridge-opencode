# 说明：跑 `npm run setup` 会生成配置文件 ~/.config/opencode/opencode-feishu.json，
# 本文件里的每一项都能写进那个配置文件的同名驼峰字段（如 FEISHU_APP_ID → appId）。
# 优先级：环境变量 > 配置文件 > 默认值。
#
# 飞书自建应用凭据（必填）。到开放平台「凭证与基础信息」拿。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 审批白名单：能点飞书审批卡/权限卡的 open_id，逗号分隔。
# 留空 = 卡片不渲染按钮，回调一律拒绝（防御深度，与 co-team 一致）。
FEISHU_APPROVERS=

# 通知落点：默认把结果推到「最后一次和机器人说话的会话」。
# 想固定到某个群，填群 chat_id（oc_ 开头）。
FEISHU_NOTIFY_CHAT_ID=

# 开放平台域名。飞书国内版 https://open.feishu.cn；Lark 国际版 https://open.larksuite.com
FEISHU_API_BASE=https://open.feishu.cn

# 长连接入站（推荐，无需公网）：开放平台「事件与回调」要切到「使用长连接接收事件」。
FEISHU_WS_ENABLED=true

# HTTP webhook 入站（可选，二选一或共存）。填端口才启用；需要飞书云可达。
FEISHU_WEBHOOK_PORT=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# 会话策略：
#   new-per-chat  每个飞书会话（chat）一个 opencode session（默认）
#   shared        所有飞书用户共用一个 opencode session
FEISHU_SESSION_MODE=new-per-chat

# 日志级别：debug | info | warn | error
FEISHU_LOG_LEVEL=info
# 追加写日志文件（可选，排查「为什么没反应」用）
FEISHU_LOG_FILE=
